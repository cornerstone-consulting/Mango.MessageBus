<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Mango.MessageBus</PackageId>

    <Version>4.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <Authors>Mahamadkasim Sache</Authors>

    <Description>Shared Message Bus library for Mango Microservices.</Description>

    <RepositoryUrl>https://github.com/cornerstone-consulting/Mango.MessageBus</RepositoryUrl>

    <Company>Cornerstone-Consulting</Company>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.0" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

</Project>
